[Unit]
Description=FBOLeads - Gunicorn
After=network.target

[Service]
Type=simple
User=fboleads
Group=fboleads
WorkingDirectory=/opt/fboleads/app
ExecStart=/opt/fboleads/app/venv/bin/gunicorn fboleads.wsgi:application \
    --bind unix:/run/fboleads/gunicorn.sock \
    --workers 2
RuntimeDirectory=fboleads
Restart=on-failure

[Install]
WantedBy=multi-user.target
